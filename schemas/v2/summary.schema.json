{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theinfosecguy/razin/schemas/v2/summary.schema.json",
  "title": "Razin Summary",
  "description": "Per-skill summary report produced by a Razin scan.",
  "type": "object",
  "required": [
    "schema_version",
    "skill",
    "overall_score",
    "overall_severity",
    "finding_count",
    "counts_by_severity",
    "counts_by_rule",
    "top_risks",
    "review_priority",
    "review_priority_level",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version identifier.",
      "const": "2.0.0"
    },
    "skill": {
      "type": "string",
      "description": "Skill name."
    },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Deprecated compatibility alias of review_priority; not a probability."
    },
    "overall_severity": {
      "$ref": "#/$defs/Severity"
    },
    "review_priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Non-probabilistic triage priority based on the strongest actionable evidence."
    },
    "review_priority_level": {
      "$ref": "#/$defs/Severity"
    },
    "assessment": {
      "$ref": "#/$defs/Assessment"
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of findings for this skill."
    },
    "counts_by_severity": {
      "type": "object",
      "required": ["low", "medium", "high"],
      "properties": {
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Finding counts keyed by severity."
    },
    "counts_by_rule": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Finding counts keyed by rule_id."
    },
    "top_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TopRisk"
      },
      "description": "Actionable security evidence first, then contextual findings; ties sort by (-score, id)."
    },
    "shown_finding_count": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Displayed findings count when output filters are enabled."
    },
    "output_filter": {
      "oneOf": [
        {
          "$ref": "#/$defs/OutputFilter"
        },
        {
          "type": "null"
        }
      ],
      "description": "Applied output filters and shown/total counts."
    },
    "rule_overrides": {
      "oneOf": [
        {
          "$ref": "#/$defs/RuleOverrides"
        },
        {
          "type": "null"
        }
      ],
      "description": "Active rule override metadata from configuration."
    },
    "rules_executed": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Rule ids executed for the scan run."
    },
    "rules_disabled": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Rule ids skipped for the scan run."
    },
    "disable_sources": {
      "oneOf": [
        {
          "$ref": "#/$defs/DisableSources"
        },
        {
          "type": "null"
        }
      ],
      "description": "Disable source metadata keyed by skipped rule id."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "TopRisk": {
      "type": "object",
      "required": ["id", "rule_id", "title", "severity", "score", "signal_kind", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Finding identifier."
        },
        "rule_id": {
          "type": "string",
          "description": "Detector rule identifier."
        },
        "title": {
          "type": "string",
          "description": "Short finding title."
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Rule-local review weight; not a probability."
        },
        "signal_kind": {
          "$ref": "#/$defs/SignalKind"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": ["path", "line", "snippet"],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": ["integer", "null"]
        },
        "snippet": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "Assessment": {
      "type": "string",
      "enum": [
        "malicious/high-confidence-chain",
        "risky-but-legitimate/review",
        "dynamic-analysis-required/unknown",
        "clean/no-evidence"
      ]
    },
    "SignalKind": {
      "type": "string",
      "enum": [
        "capability",
        "review",
        "dangerous_behavior",
        "known_malicious_ioc",
        "integrity_violation",
        "attack_chain",
        "analysis_gap"
      ]
    },
    "OutputFilter": {
      "type": "object",
      "required": ["min_severity", "security_only", "shown", "total", "filtered"],
      "properties": {
        "min_severity": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", null]
        },
        "security_only": {
          "type": "boolean"
        },
        "shown": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "filtered": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RuleOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "max_severity": {
            "$ref": "#/$defs/Severity"
          },
          "min_severity": {
            "$ref": "#/$defs/Severity"
          }
        },
        "additionalProperties": false
      }
    },
    "DisableSources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DisableSource"
      }
    },
    "DisableSource": {
      "type": "string",
      "enum": ["config", "cli-disable", "cli-only"]
    }
  }
}
