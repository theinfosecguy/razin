{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theinfosecguy/razin/schemas/benchmark_groups.schema.json",
  "title": "Razin Authoritative Benchmark Relationships",
  "type": "object",
  "required": ["schema_version", "authority", "relationships"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "authority": {
      "type": "object",
      "required": ["status", "source", "manifest_sha256"],
      "properties": {
        "status": { "const": "authoritative" },
        "source": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id", "sample_ids"],
        "properties": {
          "kind": { "enum": ["campaign", "lineage", "independent"] },
          "id": { "type": "string", "minLength": 1 },
          "sample_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
